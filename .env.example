# Server Configuration
PORT=9547       # HTTP REST API, Interactive Web Console & Swagger UI
SMTP_PORT=9548  # Inbound SMTP Server Relay & Bridge
NODE_ENV=development

# Database Path (SQLite WAL Mode)
DB_PATH=data/thotsakan.db

# 32-byte Hex Encryption Key for Sensitive Credentials (Required)
# Example: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# License Key (Optional - Fallbacks to COMMUNITY tier if not provided)
LICENSE_KEY=

# Dead-Letter Webhook URL for FAILED alerts (Discord / Slack / Generic Webhook)
DEAD_LETTER_WEBHOOK_URL=

# Retention Configuration
LOG_RETENTION_DAYS=90
